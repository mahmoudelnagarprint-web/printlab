<UserControl x:Class="ElnagarPrint.RIP.UI.Views.TabConsumptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,12">

            <!-- ══ الحاسبة ══ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="💧 حاسبة استهلاك الحبر التقديرية" Style="{StaticResource SectionHeaderStyle}"/>
                        <Button Content="🗑 تصفير العدادات"
                                Style="{StaticResource DarkButtonStyle}"
                                HorizontalAlignment="Right"
                                Click="ResetMeters_Click"/>
                    </Grid>

                    <TextBlock Text="• التقدير يعمل تلقائيًا بعد كل معاينة أو طباعة"
                               FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,8"/>

                    <!-- الكروت -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#0F1418" BorderBrush="#223038" BorderThickness="1"
                                CornerRadius="4" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="إجمالي الحبر" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding CostTotalMl, Mode=OneWay}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource CyanAccentBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#181209" BorderBrush="{StaticResource BorderGoldBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="التكلفة الإجمالية" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding CostTotalEgp, Mode=OneWay}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource GoldBrightBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#0F1418" BorderBrush="#223038" BorderThickness="1"
                                CornerRadius="4" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="تكلفة النسخة" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding CostPerCopyEgp, Mode=OneWay}"
                                           FontSize="17" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- التفصيل -->
                    <Border Background="#0A0A0A" BorderBrush="#222222" BorderThickness="1"
                            CornerRadius="2" Padding="10,8" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="تفصيل القنوات (ملليلتر):" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding CostBreakdown, Mode=OneWay}"
                                       FontSize="13" FontFamily="Consolas" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══ أسعار الحبر ══ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="💰 أسعار الحبر المفترضة (قابلة للتعديل)" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="C (ج/لتر)" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="850"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBlock Text="M (ج/لتر)" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="850"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,6,0">
                            <TextBlock Text="Y (ج/لتر)" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="750"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,6,0">
                            <TextBlock Text="K (ج/لتر)" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="650"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="0,0,6,0">
                            <TextBlock Text="Lc (ج/لتر)" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="900"/>
                        </StackPanel>
                        <StackPanel Grid.Column="5">
                            <TextBlock Text="Lm (ج/لتر)" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="900"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>