<UserControl x:Class="ElnagarPrint.RIP.UI.Views.TabColorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,12">

            <!-- ══ وضع اللون ══ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="🎨 وضع اللون (6 أوضاع)" Style="{StaticResource SectionHeaderStyle}"/>
                    <ComboBox SelectedIndex="{Binding ColorMode, Converter={StaticResource EnumIndexConverter}}" Margin="0,4" Width="320" HorizontalAlignment="Left">
                        <ComboBoxItem Content="رمادي (K فقط) — Monochrome"/>
                        <ComboBoxItem Content="رمادي RGB — Grayscale"/>
                        <ComboBoxItem Content="صورة قياسية CMYK"/>
                        <ComboBoxItem Content="صورة زاهية — للفيزيل"/>
                        <ComboBoxItem Content="سبلمايشن — حبر كثيف"/>
                        <ComboBoxItem Content="فيلم شفاف — للطباعة على التيشيرت"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- ══ نوايا التحويل ICC ══ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="🎯 نوايا تحويل ICC (Rendering Intent)" Style="{StaticResource SectionHeaderStyle}"/>
                    <ComboBox SelectedIndex="{Binding RenderingIntent, Converter={StaticResource EnumIndexConverter}}" Margin="0,4" Width="360" HorizontalAlignment="Left">
                        <ComboBoxItem Content="إدراكي موفّر للحبر ⚡ (توفير 20–35%)"/>
                        <ComboBoxItem Content="إدراكي للصور"/>
                        <ComboBoxItem Content="إدراكي قياسي"/>
                        <ComboBoxItem Content="تشبع — للجرافيك"/>
                        <ComboBoxItem Content="لوني مطلق"/>
                        <ComboBoxItem Content="لوني نسبي"/>
                        <ComboBoxItem Content="بدون تصحيح"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- ══ فضاء الألوان والإضاءة ══ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="💡 فضاءات الألوان والإضاءة" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="فضاء اللون:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding ColorSpace, Converter={StaticResource EnumIndexConverter}}" Margin="0,0,12,0">
                            <ComboBoxItem Content="sRGB"/>
                            <ComboBoxItem Content="Adobe RGB"/>
                            <ComboBoxItem Content="ProPhoto RGB"/>
                            <ComboBoxItem Content="CMYK (الجهاز)"/>
                        </ComboBox>

                        <TextBlock Grid.Column="2" Text="نقطة البياض:" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <RadioButton Content="D50 (طباعة)" GroupName="WP"
                                         IsChecked="{Binding WhitePoint, Converter={StaticResource EnumEqualConverter}, ConverterParameter=D50}"/>
                            <RadioButton Content="D65 (شاشة)" GroupName="WP" Margin="16,0,0,0"
                                         IsChecked="{Binding WhitePoint, Converter={StaticResource EnumEqualConverter}, ConverterParameter=D65}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ محاور LAB والإشباع ══ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="🌈 محاور LAB والإشباع" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="L (سطوع):" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding LabL}"
                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="2" Text="{Binding LabL}" HorizontalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="A (أحمر/أخضر):" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding LabA}"
                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="2" Text="{Binding LabA}" HorizontalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="B (أصفر/أزرق):" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding LabB}"
                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="2" Text="{Binding LabB}" HorizontalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="الإشباع:" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding Saturation}"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="2" Text="{Binding Saturation, StringFormat={}{0:P0}}" HorizontalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>