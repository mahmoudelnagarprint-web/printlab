<UserControl x:Class="ElnagarPrint.RIP.UI.Views.TabOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,12">

            <!-- ══ الدقة وعمق المعالجة ══ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="🔬 الدقة وعمق المعالجة" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="دقة المعالجة:" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="8-bit (أسرع)" GroupName="BitDepth" Margin="0,0,16,0"
                                         IsChecked="{Binding BitDepth, Converter={StaticResource EnumEqualConverter}, ConverterParameter=Eight}"/>
                            <RadioButton Content="16-bit (أدق للغرادِيِنت)" GroupName="BitDepth"
                                         IsChecked="{Binding BitDepth, Converter={StaticResource EnumEqualConverter}, ConverterParameter=Sixteen}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="دقة الطباعة:" VerticalAlignment="Center"/>
                        <ComboBox SelectedIndex="{Binding Resolution, Converter={StaticResource EnumIndexConverter}}" Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="360 dpi — مسودة"/>
                            <ComboBoxItem Content="720 dpi — قياسي"/>
                            <ComboBoxItem Content="1440 dpi — عالي"/>
                            <ComboBoxItem Content="2880 dpi — أقصى"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ الميكانيكا ══ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="⚙ الميكانيكا — تجفيف واتجاه وارتفاع" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="اتجاه الطباعة:" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="ثنائي الاتجاه (سريع)" GroupName="Dir" Margin="0,0,16,0"
                                         IsChecked="{Binding PrintDirection, Converter={StaticResource EnumEqualConverter}, ConverterParameter=BiDirectional}"/>
                            <RadioButton Content="أحادي (جودة أعلى)" GroupName="Dir"
                                         IsChecked="{Binding PrintDirection, Converter={StaticResource EnumEqualConverter}, ConverterParameter=UniDirectional}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ارتفاع الرأس:" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="5" Value="{Binding HeadHeightValue}"
                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="2" Text="{Binding HeadHeightValue}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <CheckBox Content="وقفات تجفيف الحبر بين التمريرات (Smart Drying Pause)"
                              IsChecked="{Binding DryingPause}" Margin="0,8,0,0"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="مدة الوقفة (ms):" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="2000"
                                Value="{Binding DryingPauseMs}"
                                IsSnapToTickEnabled="True" TickFrequency="50"
                                IsEnabled="{Binding DryingPause}"/>
                        <TextBox Grid.Column="2" Text="{Binding DryingPauseMs, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>

                    <CheckBox Content="قص الرول التلقائي (Roll Auto-Cut)"
                              IsChecked="{Binding AutoRollCut}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- ══ محرك الإخراج ══ -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="🖨 محرك الإخراج (ESC/P2)" Style="{StaticResource SectionHeaderStyle}"/>
                    <CheckBox Content="ضغط RLE للبيانات (سرعة إرسال أعلى)"
                              IsChecked="{Binding UseRleCompression}" Margin="0,2"/>
                    <CheckBox Content="تشغيل الـ Weave (توزيع Nozzles ضد الـ Banding)"
                              IsChecked="{Binding UseWeave}" Margin="0,6"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>