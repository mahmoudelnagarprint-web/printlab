<UserControl x:Class="ElnagarPrint.RIP.UI.Views.TabInkCtrlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,14">
            <!-- الأهم أولًا: Lc / Lm -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16" BorderBrush="{StaticResource BorderGoldBrush}" BorderThickness="1.5">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="✦  التحكم في القنوات الفاتحة" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        <TextBlock Text="قفل حقيقي داخل المحرك" HorizontalAlignment="Left" Foreground="{StaticResource SuccessGreenBrush}" FontSize="11"/>
                    </Grid>
                    <TextBlock Text="القفل يوقف القناة بالكامل. النسبة تضبط كمية التدرجات الفاتحة عند تشغيلها."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,14"/>

                    <Border Background="#102329" BorderBrush="#155D69" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource CyanAccentBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="Light Cyan" Foreground="{StaticResource CyanAccentBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Content="🔒 قفل" FontSize="11" VerticalAlignment="Center" IsChecked="{Binding LockLightCyan}"/>
                            <Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding LcInkPercent}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" IsEnabled="{Binding Path=LockLightCyan, Converter={StaticResource InverseBoolConverter}}"/>
                            <TextBlock Grid.Column="3" Text="{Binding LcInkPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource CyanAccentBrush}" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <Border Background="#2A1020" BorderBrush="#7A204B" BorderThickness="1" CornerRadius="5" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource MagentaAccentBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="Light Magenta" Foreground="{StaticResource MagentaAccentBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Content="🔒 قفل" FontSize="11" VerticalAlignment="Center" IsChecked="{Binding LockLightMagenta}"/>
                            <Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding LmInkPercent}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" IsEnabled="{Binding Path=LockLightMagenta, Converter={StaticResource InverseBoolConverter}}"/>
                            <TextBlock Grid.Column="3" Text="{Binding LmInkPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MagentaAccentBrush}" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="⚡ قفل القناتين" Style="{StaticResource GoldButtonStyle}" Click="ZeroLightInks_Click"/>
                        <Button Content="↩ إرجاع وفك القفل" Style="{StaticResource DarkButtonStyle}" Margin="8,0,0,0" Click="RestoreLightInks_Click"/>
                        <Button Content="عرض الحالة" Style="{StaticResource DarkButtonStyle}" Margin="8,0,0,0" Click="ShowGates_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="GatesStatusText" Text="حالة القنوات: Lc=100%  |  Lm=0%" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource SuccessGreenBrush}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- إعدادات الأسود والحدود -->
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="⬛  التحكم بالأسود" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        <TextBlock Text="UCR / Black Level" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="100" Value="{Binding BlackLevel}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding BlackLevel, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Text="0% = CMY فقط  ·  100% = أقصى استبدال بالأسود" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="🧪  الحد الإجمالي للحبر" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        <TextBlock Text="Total Ink Limit" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                            <Slider Minimum="100" Maximum="400" Value="{Binding TotalInkLimit}" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding TotalInkLimit, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Text="النطاق الآمن المبدئي: 240–320%" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="🎨  حدود القنوات الأساسية" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cyan" Foreground="{StaticResource CyanAccentBrush}"/>
                            <Slider Minimum="0" Maximum="100" Value="{Binding CyanInkLimit}" Margin="0,5,0,12"/>
                            <TextBlock Text="Yellow" Foreground="#E6C84A"/>
                            <Slider Minimum="0" Maximum="100" Value="{Binding YellowInkLimit}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Magenta" Foreground="{StaticResource MagentaAccentBrush}"/>
                            <Slider Minimum="0" Maximum="100" Value="{Binding MagentaInkLimit}" Margin="0,5,0,12"/>
                            <TextBlock Text="Black" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Slider Minimum="0" Maximum="100" Value="{Binding BlackInkLimit}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
