<UserControl x:Class="ElnagarPrint.RIP.UI.Views.TabCorrectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,12">

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="🎚 التصحيح اليدوي المنفصل (0–200%)" Style="{StaticResource SectionHeaderStyle}"/>
                        <Button Content="إعادة ضبط 100%"
                                Style="{StaticResource DarkButtonStyle}"
                                HorizontalAlignment="Right"
                                Click="ResetAll_Click"/>
                    </Grid>

                    <!-- Cyan -->
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="18"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Fill="#00BCD4" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Cyan" Margin="18,0,0,0" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding CorrCyan}"
                                TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <TextBox Grid.Column="2" Text="{Binding CorrCyan, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" Margin="3,0,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>

                    <!-- Magenta -->
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="18"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Fill="#E91E63" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Magenta" Margin="18,0,0,0" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding CorrMagenta}"
                                TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <TextBox Grid.Column="2" Text="{Binding CorrMagenta, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" Margin="3,0,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>

                    <!-- Yellow -->
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="18"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Fill="#FFC107" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Yellow" Margin="18,0,0,0" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding CorrYellow}"
                                TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <TextBox Grid.Column="2" Text="{Binding CorrYellow, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" Margin="3,0,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>

                    <!-- Black -->
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="18"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Fill="#9E9E9E" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Black" Margin="18,0,0,0" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding CorrBlack}"
                                TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <TextBox Grid.Column="2" Text="{Binding CorrBlack, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" Margin="3,0,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>

                    <TextBlock Text="• 100% = الوضع الطبيعي • 200% = ضعف الحبر • 0% = إيقاف القناة"
                               FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>