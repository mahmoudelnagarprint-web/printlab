<Window x:Class="ElnagarPrint.RIP.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ElnagarPrint.RIP.UI.Converters"
        xmlns:views="clr-namespace:ElnagarPrint.RIP.UI.Views"
        Title="النجار برنت — Epson RIP v4"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- نمط زر التنقّل السفلي — كروت عريضة مثل التصميم -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#141414"
                                BorderBrush="{StaticResource BorderDarkBrush}"
                                BorderThickness="1" CornerRadius="8" Margin="4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="18,10"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="#2A2410"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GoldAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  الشريط العلوي: العنوان + حالة الطابعة + زر طباعة كبير    -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BackgroundPanelBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <DockPanel>
                <!-- زر الطباعة الذهبي الكبير — أبرز عنصر (يسار في RTL) -->
                <Button DockPanel.Dock="Left" x:Name="PrintButton"
                        Content="🖨  طباعة"
                        FontSize="17" FontWeight="Bold"
                        Style="{StaticResource GoldButtonStyle}"
                        Padding="34,10" Click="Print_Click"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="♛" FontSize="26" Foreground="{StaticResource GoldBrightBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="النجار برنت" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="RIP v4" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource GoldBrightBrush}"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- وسط الشريط: حالة الطابعة + أدوات — يلتف تلقائيًا في الشاشات الضيقة -->
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#101010" BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="14,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PrinterStatusDot" Width="10" Height="10"
                                     Fill="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PrinterStatusText" Text="الطابعة: غير متصلة"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Button Content="🔌 اختبار" Style="{StaticResource DarkButtonStyle}"
                            Margin="10,0,0,0" Padding="10,4" Click="TestConnection_Click"
                            ToolTip="تشخيص كامل: LibUsb + طوابير Windows + فتح تجريبي"/>
                    <Button Content="اختيار صورة…" Style="{StaticResource DarkButtonStyle}"
                            Margin="10,0,0,0" Padding="10,4" Click="BrowseImage_Click"/>
                    <Button Content="🔍 معاينة" Style="{StaticResource DarkButtonStyle}"
                            Margin="10,0,0,0" Padding="10,4" Click="Preview_Click"/>
                    <Button x:Name="CancelPrintButton" Content="إلغاء"
                            Style="{StaticResource DangerButtonStyle}"
                            Margin="10,0,0,0" Padding="10,4" IsEnabled="False"
                            Click="CancelPrint_Click"/>
                    <ToggleButton x:Name="QuickModeToggle" Checked="QuickMode_Changed" Unchecked="QuickMode_Changed"
                                  Margin="10,0,0,0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bd" Background="#1F1F1F"
                                        BorderBrush="{StaticResource BorderDarkBrush}"
                                        BorderThickness="1" CornerRadius="16" Padding="12,7">
                                    <TextBlock x:Name="txt" Text="⚡ وضع الورشة"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                                        <Setter TargetName="bd" Property="Background" Value="#2A2410"/>
                                        <Setter TargetName="txt" Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </WrapPanel>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  شريط التنقّل السفلي + سجل العمليات                       -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource BackgroundPanelBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,8">
            <StackPanel>
                <!-- شريط التقدم -->
                <Grid Margin="2,0,2,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <ProgressBar x:Name="PrintProgress" Height="8" Minimum="0" Maximum="100" Value="0"/>
                        <TextBlock x:Name="ProgressText" Text="جاهز — اختر صورة واضغط طباعة"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- أزرار التنقّل الستة — كروت عريضة -->
                <Border x:Name="NavBar" Background="#0F0F0F"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="8,6">
                    <UniformGrid Columns="6">
                        <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                     Tag="home" IsChecked="True" Checked="Nav_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="الرئيسية" FontSize="14" FontWeight="Bold" Margin="8,0,0,0"
                                           Foreground="{StaticResource GoldBrightBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                     Tag="layout" Checked="Nav_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="التخطيط" FontSize="14" Margin="8,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                     Tag="color" Checked="Nav_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎨" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="الألوان" FontSize="14" Margin="8,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                     Tag="ink" Checked="Nav_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💧" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="الحبر" FontSize="14" Margin="8,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                     Tag="correction" Checked="Nav_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎚" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="التصحيح" FontSize="14" Margin="8,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                     Tag="options" Checked="Nav_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="الخيارات" FontSize="14" Margin="8,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </Border>

                <!-- سجل العمليات — قابل للطي مثل التصميم -->
                <Expander Margin="0,8,0,0" IsExpanded="False">
                    <Expander.Header>
                        <TextBlock Text="☰  سجل العمليات" FontWeight="Bold"
                                   Foreground="{StaticResource GoldAccentBrush}"/>
                    </Expander.Header>
                    <Border Background="#0A0A0A" BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="6" Margin="0,6,0,0">
                        <TextBox x:Name="StatusLog" IsReadOnly="True"
                                 Background="Transparent" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="11.5"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 Height="160" VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                    </Border>
                </Expander>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  المنطقة الوسطى: لوحة الرئيسية أو صفحات التنقّل            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid>
            <!-- ═══ لوحة الرئيسية (3 أعمدة مثل التصميم) ═══ -->
            <Grid x:Name="HomePanel" Margin="12,10,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300"/>          <!-- المعاينة (يسار RTL) -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1.05*" MinWidth="360"/>      <!-- إعدادات سريعة -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="0.72*" MinWidth="290"/>      <!-- حالة الطباعة -->
                </Grid.ColumnDefinitions>

                <!-- ① المعاينة + سويتشات القنوات -->
                <Border Grid.Column="0" Background="{StaticResource BackgroundCardBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="👁  المعاينة"
                                   Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                        <UniformGrid DockPanel.Dock="Bottom" Columns="6" Margin="0,12,0,0">
                            <!-- سويتشات القنوات — ضغطة: عرض القناة، ضغطة ثانية: توليفي -->
                            <Button Tag="0" Click="ChannelSwatch_Click" Style="{StaticResource DarkButtonStyle}"
                                    Margin="3,0" ToolTip="Cyan">
                                <Border Width="34" Height="34" CornerRadius="6" Background="#00AEEF"/>
                            </Button>
                            <Button Tag="1" Click="ChannelSwatch_Click" Style="{StaticResource DarkButtonStyle}"
                                    Margin="3,0" ToolTip="Magenta">
                                <Border Width="34" Height="34" CornerRadius="6" Background="#EC008C"/>
                            </Button>
                            <Button Tag="2" Click="ChannelSwatch_Click" Style="{StaticResource DarkButtonStyle}"
                                    Margin="3,0" ToolTip="Yellow">
                                <Border Width="34" Height="34" CornerRadius="6" Background="#FFF200"/>
                            </Button>
                            <Button Tag="3" Click="ChannelSwatch_Click" Style="{StaticResource DarkButtonStyle}"
                                    Margin="3,0" ToolTip="Black">
                                <Border Width="34" Height="34" CornerRadius="6" Background="#111111"
                                        BorderBrush="#555555" BorderThickness="1"/>
                            </Button>
                            <Button Tag="4" Click="ChannelSwatch_Click" Style="{StaticResource DarkButtonStyle}"
                                    Margin="3,0" ToolTip="Light Cyan">
                                <Border Width="34" Height="34" CornerRadius="6" Background="#7FDBFF"/>
                            </Button>
                            <Button Tag="5" Click="ChannelSwatch_Click" Style="{StaticResource DarkButtonStyle}"
                                    Margin="3,0" ToolTip="Light Magenta">
                                <Border Width="34" Height="34" CornerRadius="6" Background="#FF9EDF"/>
                            </Button>
                        </UniformGrid>

                        <Border Background="#050505" BorderBrush="#222222" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform"/>
                                <TextBlock x:Name="PreviewPlaceholder" Text="لا توجد معاينة بعد"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="PreviewInfoText" DockPanel.Dock="Bottom" Text="—"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <!-- ② إعدادات سريعة + القنوات الفاتحة + الورق -->
                <!-- العمود الأوسط: قابل للتمرير كاملًا — يعرض كل الكروت على أي شاشة -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              Padding="0,0,4,0">
                <StackPanel>

                    <Border Background="{StaticResource BackgroundCardBrush}"
                            BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="🎛  إعدادات سريعة" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                                <Button Content="↺ تصفير" Style="{StaticResource DarkButtonStyle}"
                                        Padding="12,3" HorizontalAlignment="Left"
                                        Click="ResetQuickAdjust_Click"
                                        ToolTip="إرجاع الكثافة والسطوع والتباين والإشباع إلى 100%"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="62"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الكثافة" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding Density}"
                                        TickFrequency="0.05"/>
                                <TextBox Grid.Column="2" TextAlignment="Center" Padding="2,3" Margin="8,0,0,0"
                                         Text="{Binding Density, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="62"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="السطوع" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding Brightness}"
                                        TickFrequency="0.05"/>
                                <TextBox Grid.Column="2" TextAlignment="Center" Padding="2,3" Margin="8,0,0,0"
                                         Text="{Binding Brightness, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="62"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="التباين" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding Contrast}"
                                        TickFrequency="0.05"/>
                                <TextBox Grid.Column="2" TextAlignment="Center" Padding="2,3" Margin="8,0,0,0"
                                         Text="{Binding Contrast, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="62"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الإشباع" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding Saturation}"
                                        TickFrequency="0.05"/>
                                <TextBox Grid.Column="2" TextAlignment="Center" Padding="2,3" Margin="8,0,0,0"
                                         Text="{Binding Saturation, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <TextBlock Text="• أي تحريك للسلايدر يُحدّث المعاينة لايف"
                                       FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- القنوات الفاتحة — بالأقفال مثل التصميم -->
                    <Border Background="{StaticResource BackgroundCardBrush}"
                            BorderBrush="{StaticResource BorderGoldBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="💧  القنوات الفاتحة" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="58"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Light Cyan Lc" VerticalAlignment="Center"
                                           Foreground="{StaticResource CyanAccentBrush}"/>
                                <CheckBox Grid.Column="1" Content="🔒" IsChecked="{Binding LockLightCyan}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          ToolTip="قفل القناة = صفر حبر فعليًا"/>
                                <Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding LcInkPercent}"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        IsEnabled="{Binding LockLightCyan, Converter={StaticResource InverseBoolConverter}}"/>
                                <TextBox Grid.Column="3" TextAlignment="Center" Padding="2,3" Margin="8,0,0,0"
                                         Text="{Binding LcInkPercent, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="58"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Light Magenta Lm" VerticalAlignment="Center"
                                           Foreground="{StaticResource MagentaAccentBrush}"/>
                                <CheckBox Grid.Column="1" Content="🔒" IsChecked="{Binding LockLightMagenta}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          ToolTip="قفل القناة = صفر حبر فعليًا"/>
                                <Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding LmInkPercent}"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        IsEnabled="{Binding LockLightMagenta, Converter={StaticResource InverseBoolConverter}}"/>
                                <TextBox Grid.Column="3" TextAlignment="Center" Padding="2,3" Margin="8,0,0,0"
                                         Text="{Binding LmInkPercent, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- الورق والجودة — نقلنا وظيفة تبويب Main هنا -->
                    <Border Background="{StaticResource BackgroundCardBrush}"
                            BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,10,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="📄  الورق والجودة" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="مقاس الورق" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding PaperSize, Converter={StaticResource EnumIndexConverter}}">
                                        <ComboBoxItem Content="A4"/><ComboBoxItem Content="A5"/>
                                        <ComboBoxItem Content="A3"/><ComboBoxItem Content="A3+"/>
                                        <ComboBoxItem Content="Letter"/><ComboBoxItem Content="Legal"/>
                                        <ComboBoxItem Content="رول 100مم"/><ComboBoxItem Content="رول 210مم"/>
                                        <ComboBoxItem Content="مخصص"/>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,8,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="مصدر الورق" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding PaperSource, Converter={StaticResource EnumIndexConverter}}">
                                        <ComboBoxItem Content="الدرج الخلفي"/><ComboBoxItem Content="الدرج الأمامي"/>
                                        <ComboBoxItem Content="رول الورق"/><ComboBoxItem Content="يدوي"/>
                                    </ComboBox>
                                </Grid>
                                <CheckBox Content="طباعة بلا حواف (Borderless)" IsChecked="{Binding Borderless}" Margin="0,8,0,0"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="الجودة" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="1" Maximum="7" Value="{Binding QualityLevel}"
                                            TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="2" Text="{Binding QualityLevel}" FontWeight="Bold"
                                               Foreground="{StaticResource GoldBrightBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding QualityDescription}" FontSize="11"
                                           Foreground="{StaticResource GoldAccentBrush}"
                                           HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
                </ScrollViewer>

                <!-- ③ حالة الطباعة — الحلقة الدائرية + التفاصيل + التكلفة -->
                <Border Grid.Column="4" Background="{StaticResource BackgroundCardBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="📄  حالة الطباعة" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>

                        <!-- الحلقة الدائرية للتقدم -->
                        <Grid Height="170" Margin="0,4,0,10">
                            <Path x:Name="RingBackground" Stroke="#2A2A2A" StrokeThickness="14"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Path x:Name="RingProgress" Stroke="{StaticResource GoldBrightBrush}" StrokeThickness="14"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RingPercentText" Text="0%" FontSize="34" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- صفوف الحالة -->
                        <Separator Background="{StaticResource BorderDarkBrush}"/>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="الدقة" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResolutionText}" FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrightBrush}"/>
                        </Grid>
                        <Separator Background="{StaticResource BorderDarkBrush}"/>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="الألوان" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="CMYKcc" FontWeight="Bold"/>
                        </Grid>
                        <Separator Background="{StaticResource BorderDarkBrush}"/>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="النسخ" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Copies}" FontWeight="Bold"/>
                        </Grid>
                        <Separator Background="{StaticResource BorderDarkBrush}"/>

                        <!-- التكلفة -->
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="تكلفة النسخة" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding CostPerCopyEgp}" FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrightBrush}"/>
                        </Grid>
                        <TextBlock Text="{Binding CostTotalMl}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding CostBreakdown}" FontSize="10.5" FontFamily="Consolas"
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <Button Content="🗑 تصفير العدادات" Style="{StaticResource DarkButtonStyle}"
                                Padding="8,3" HorizontalAlignment="Right" Margin="0,6,0,0"
                                Click="ResetMeters_Click"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <TextBlock Text="✅" FontSize="18" VerticalAlignment="Center"
                                       Visibility="{Binding CanPrint, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="جاهز للطباعة" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessGreenBrush}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- 🖨 حالات الطابعة — تاب يفتح ويقفل -->
                        <Expander x:Name="PrinterStatusExpander" Margin="0,12,0,0"
                                  Expanded="PrinterStatusExpander_Expanded">
                            <Expander.Header>
                                <TextBlock Text="🖨  حالات الطابعة" FontWeight="Bold"
                                           Foreground="{StaticResource GoldAccentBrush}"/>
                            </Expander.Header>
                            <Border Background="#0A0A0A" BorderBrush="{StaticResource BorderDarkBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="PanelStatusDot" Width="10" Height="10"
                                                     Fill="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PanelStatusText" Text="الطابعة: غير متصلة"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" x:Name="PanelLastCheck" Text="—"
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Grid>
                                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,6"/>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="الجهاز" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="PanelPrinterName" Text="—"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="النقل" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="PanelTransport" Text="—"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    <Button Content="🔌 تشخيص كامل" Style="{StaticResource DarkButtonStyle}"
                                            Padding="12,3" HorizontalAlignment="Right" Margin="0,8,0,0"
                                            Click="TestConnection_Click"/>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ صفحات التنقّل (تظهر مكان اللوحة الرئيسية) ═══ -->
            <ContentControl x:Name="PageHost" Visibility="Collapsed" Margin="12,10,12,6"/>
        </Grid>
    </DockPanel>
</Window>
