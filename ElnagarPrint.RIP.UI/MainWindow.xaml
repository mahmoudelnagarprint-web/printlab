<Window x:Class="ElnagarPrint.RIP.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ElnagarPrint.RIP.UI.Views"
        Title="النجار برنت — Epson RIP v4"
        Height="860" Width="1400"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FlowDirection="RightToLeft">

    <DockPanel>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  الشريط العلوي: العنوان + وضع الورشة + حالة الطابعة      -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BackgroundPanelBrush}"
                BorderBrush="{StaticResource BorderGoldBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="♛"
                               FontSize="22"
                               Foreground="{StaticResource GoldBrightBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="النجار برنت — Epson RIP v4"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{StaticResource GoldAccentBrush}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- وضع الورشة السريع -->
                    <ToggleButton x:Name="QuickModeToggle"
                                  Checked="QuickMode_Changed"
                                  Unchecked="QuickMode_Changed">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bd"
                                        Background="#1F1F1F"
                                        BorderBrush="{StaticResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡" FontSize="13"/>
                                        <TextBlock x:Name="txt"
                                                   Text="وضع الورشة السريع"
                                                   Margin="6,0,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                                        <Setter TargetName="bd" Property="Background" Value="#2A2410"/>
                                        <Setter TargetName="txt" Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
                                        <Setter TargetName="txt" Property="Text" Value="وضع الورشة السريع ✓"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- حالة الطابعة -->
                    <Border Background="#101010"
                            BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="10,6"
                            Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PrinterStatusDot"
                                     Width="9" Height="9"
                                     Fill="{StaticResource TextMutedBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="PrinterStatusText"
                                       Text="الطابعة: غير متصلة"
                                       Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button Content="🔌 اختبار"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Margin="12,0,0,0"
                                    Padding="8,2"
                                    Click="TestConnection_Click"
                                    ToolTip="تشخيص كامل: LibUsb + طوابير Windows + فتح تجريبي"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  الشريط السفلي: معاينة + سجلات + أزرار التشغيل            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource BackgroundPanelBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,1,0,0"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>

                <!-- شريط التقدير + أزرار -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <ProgressBar x:Name="PrintProgress"
                                     Height="10"
                                     Minimum="0" Maximum="100"
                                     Value="0"/>
                        <TextBlock x:Name="ProgressText"
                                   Text="جاهز — اختر صورة واضغط طباعة"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="2,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="اختيار صورة…"
                                Style="{StaticResource DarkButtonStyle}"
                                Click="BrowseImage_Click"/>
                        <Button Content="معاينة (بدون طباعة)"
                                Style="{StaticResource DarkButtonStyle}"
                                Margin="8,0,0,0"
                                Click="Preview_Click"/>
                        <Button Content="🖨 طباعة"
                                Style="{StaticResource GoldButtonStyle}"
                                Margin="8,0,0,0"
                                Click="Print_Click"
                                x:Name="PrintButton"/>
                        <Button Content="إلغاء"
                                Style="{StaticResource DangerButtonStyle}"
                                Margin="8,0,0,0"
                                IsEnabled="False"
                                x:Name="CancelPrintButton"
                                Click="CancelPrint_Click"/>
                    </StackPanel>
                </Grid>

                <!-- سجل الحالة -->
                <Border Grid.Row="1"
                        Background="#0A0A0A"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Margin="0,8,0,8">
                    <TextBox x:Name="StatusLog"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="11.5"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"/>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  المنطقة الوسطى: التبويبات السبعة + المعاينة السريعة      -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.3*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="410"/>
            </Grid.ColumnDefinitions>

            <!-- التبويبات السبعة -->
            <TabControl Grid.Column="0"
                        x:Name="MainTabs"
                        Margin="8"
                        Background="Transparent">

                <TabItem Header="الرئيسية">
                    <views:TabMainView x:Name="TabMain"/>
                </TabItem>

                <TabItem Header="التخطيط">
                    <views:TabLayoutView x:Name="TabLayout"/>
                </TabItem>

                <TabItem Header="الألوان">
                    <views:TabColorView x:Name="TabColor"/>
                </TabItem>

                <TabItem Header="التصحيح">
                    <views:TabCorrectionView x:Name="TabCorrection"/>
                </TabItem>

                <TabItem Header="الاستهلاك">
                    <views:TabConsumptionView x:Name="TabConsumption"/>
                </TabItem>

                <TabItem Header="الحبر">
                    <views:TabInkCtrlView x:Name="TabInkCtrl"/>
                </TabItem>

                <TabItem Header="الخيارات">
                    <views:TabOptionsView x:Name="TabOptions"/>
                </TabItem>
            </TabControl>

            <!-- فاصل ذهبي -->
            <Border Grid.Column="1"
                    Background="{StaticResource BorderGoldBrush}"
                    Opacity="0.5"/>

            <!-- لوحة المعاينة السريعة -->
            <Border Grid.Column="2"
                    Background="{StaticResource BackgroundCardBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    Margin="0,8,8,8"
                    CornerRadius="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="#151515"
                            Padding="10,7">
                        <TextBlock Text="🖼 معاينة سريعة — Quick Preview"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0"/>
                    </Border>

                    <Grid DockPanel.Dock="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="300"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- مساحة المعاينة -->
                        <Border Grid.Row="0"
                                Background="#050505"
                                Margin="8"
                                BorderBrush="#222222"
                                BorderThickness="1">
                            <Grid>
                                <Image x:Name="PreviewImage"
                                       Stretch="Uniform"/>
                                <TextBlock x:Name="PreviewPlaceholder"
                                           Text="لا توجد معاينة بعد"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Grid>
                        </Border>

                        <!-- معلومات المعاينة -->
                        <Border Grid.Row="1"
                                Background="#101010"
                                Margin="8,0,8,8"
                                Padding="8,6"
                                BorderBrush="#222222"
                                BorderThickness="1"
                                CornerRadius="2">
                            <StackPanel>
                                <TextBlock x:Name="PreviewInfoText"
                                           Text="—"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="القناة: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <ComboBox x:Name="PreviewChannelCombo"
                                              Width="110"
                                              FontSize="11"
                                              SelectionChanged="PreviewChannel_SelectionChanged">
                                        <ComboBoxItem Content="توليفية (RGB)" IsSelected="True"/>
                                        <ComboBoxItem Content="Cyan"/>
                                        <ComboBoxItem Content="Magenta"/>
                                        <ComboBoxItem Content="Yellow"/>
                                        <ComboBoxItem Content="Black"/>
                                        <ComboBoxItem Content="Light Cyan"/>
                                        <ComboBoxItem Content="Light Magenta"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
